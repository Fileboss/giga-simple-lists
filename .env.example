# À copier en `.env` (chmod 600), jamais commité.

# URL publique de l'appli, telle que la tape le navigateur (sans / final).
# En local : http://localhost:5240
LISTES_ORIGIN=https://listes.example.com

# Dossier des données sur l'hôte (base SQLite). Il doit appartenir à LISTES_UID:LISTES_GID.
LISTES_DATA_LOCATION=./data
LISTES_UID=1000
LISTES_GID=1000

# Port publié sur 127.0.0.1 : le reverse proxy s'y connecte.
LISTES_PORT=5240
LISTES_CPUS=1
TZ=Europe/Paris
